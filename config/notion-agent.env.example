# Copy this file to .env.notion-agent in the repository root.
# Never commit the copied file or paste its secrets into issues or pull requests.

HORIZON_REPO_ROOT=/mnt/c/Users/Administrator/Documents/Projects/Horizon
NOTION_AGENT_RUNTIME_DIR=/mnt/c/Users/Administrator/Documents/Projects/Horizon/.codex-runtime/notion-agent
NOTION_AGENT_HOST=127.0.0.1
NOTION_AGENT_PORT=4782

# Create a Notion integration, grant it access to the task database, and store
# its secret only in the ignored local env file.
NOTION_TOKEN=secret_replace_me
NOTION_DATA_SOURCE_ID=67132048-6501-4156-be51-28a288d6b771
NOTION_WORKSPACE_ID=c3b38754-01a1-43f4-852d-68060310b541

# These names match the Horizon task data source configured in Notion.
NOTION_TITLE_PROPERTY=Task
NOTION_STATUS_PROPERTY=Status
NOTION_READY_STATUS="Ready for Codex"
NOTION_WORKING_STATUS=Coding
NOTION_REVIEW_STATUS=Review
NOTION_BLOCKED_STATUS=Blocked
NOTION_RUN_ID_PROPERTY="Agent Run ID"
NOTION_PR_URL_PROPERTY="PR URL"
NOTION_RESULT_PROPERTY="Agent Result"
NOTION_RISK_PROPERTY=Risk
NOTION_ALLOWED_PATHS_PROPERTY="Allowed Paths"
NOTION_VERIFICATION_PROPERTY=Verification

# Optional but recommended after the first webhook event confirms the value.
NOTION_INTEGRATION_ID=

# Generate a random local value, then append ?setup=<this value> to the URL
# entered in Notion. It authorizes only the unsigned initial verification call.
NOTION_WEBHOOK_BOOTSTRAP_SECRET=replace-with-a-random-64-character-value

# The listener captures Notion's verification token in its ignored runtime
# directory. You may instead set the value explicitly here after verification.
NOTION_WEBHOOK_VERIFICATION_TOKEN=
NOTION_WEBHOOK_EVENT_TYPES=page.created,page.properties_updated,page.content_updated

GITHUB_REPOSITORY=ChiosYang/Horizon
GITHUB_DEFAULT_BRANCH=main

# codex exec uses the ChatGPT login already stored on this computer.
CODEX_BIN=codex
CLOUDFLARED_BIN=cloudflared
CODEX_MODEL=gpt-5.6-sol
CODEX_REASONING_EFFORT=xhigh
CODEX_TIMEOUT_SECONDS=3600
CODEX_VERIFICATION_COMMAND=uv run pytest
CODEX_VERIFICATION_TIMEOUT_SECONDS=1800

# Keep failed worktrees for inspection. Successful worktrees are removed.
NOTION_AGENT_ALLOWED_RISKS=Low
NOTION_AGENT_REQUIRE_ALLOWED_PATHS=true
NOTION_AGENT_MAX_CHANGED_FILES=50
NOTION_AGENT_KEEP_FAILED_WORKTREES=true
NOTION_AGENT_QUEUE_POLL_SECONDS=1
NOTION_AGENT_LOG_LEVEL=INFO
