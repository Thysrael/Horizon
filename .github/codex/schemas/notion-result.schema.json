{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horizon Notion Codex result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "summary",
    "files_changed",
    "verification",
    "risks",
    "requires_human"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["success", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 200
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 100
    },
    "requires_human": {
      "type": "boolean"
    }
  }
}
