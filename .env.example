# Copy this file to .env and replace every value labelled "replace".
# Never commit .env or send it to a Telegram chat.

# PostgreSQL is addressed by the Compose service name from application containers.
POSTGRES_USER=infoservice
POSTGRES_PASSWORD=replace-with-a-long-random-postgres-password
POSTGRES_DB=infoservice
DATABASE_URL=postgresql+asyncpg://infoservice:replace-with-a-long-random-postgres-password@postgres:5432/infoservice

# Create the bot through @BotFather.  This is the operator token, not a user LLM key.
TELEGRAM_BOT_TOKEN=replace-with-botfather-token

# Generate once with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it makes previously encrypted user keys unreadable.
APP_ENCRYPTION_KEY=replace-with-a-fernet-key

# DeepSeek is bring-your-own-key in v1.  Do not set a shared provider key here.
DEEPSEEK_DEFAULT_MODEL=deepseek-v4-flash

# Process and retention limits.
WORKER_CONCURRENCY=2
STALE_RUN_MINUTES=30
SCHEDULER_POLL_SECONDS=30
RUN_RETENTION_DAYS=30
MAX_REPORTS_PER_USER=5
MAX_SOURCES_PER_REPORT=30

# Optional source integrations.  Enabling one requires APP_IMAGE_TARGET=runtime-full
# before `docker compose up --build`.
APP_IMAGE_TARGET=runtime
ENABLE_TWITTER=false
ENABLE_OPENBB=false
APIFY_TOKEN=replace-only-when-twitter-is-enabled
