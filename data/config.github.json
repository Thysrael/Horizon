{
  "ai": {
    "provider": "openai",
    "model": "poolside/laguna-s-2.1:free",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["en"],
    "analysis_concurrency": 5,
    "enrichment_concurrency": 5
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      },
      "finance-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tools-update": {
        "threshold": 5.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "github": [
      {
        "type": "user_events",
        "username": "torvalds",
        "enabled": false
      },
      {
        "type": "repo_releases",
        "owner": "astral-sh",
        "repo": "uv",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "zed-industries",
        "repo": "zed",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "neovim",
        "repo": "neovim",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "modem-dev",
        "repo": "hunk",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "jj-vcs",
        "repo": "jj",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "idursun",
        "repo": "jjui",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "EzraCerpac",
        "repo": "jj-waltz",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "max-sixty",
        "repo": "worktrunk",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "ogulcancelik",
        "repo": "herdr",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "jesseduffield",
        "repo": "lazygit",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "anomalyco",
        "repo": "opencode",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "openai",
        "repo": "codex",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "earendil-works",
        "repo": "pi",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "xai-org",
        "repo": "grok-build",
        "enabled": true,
        "profile": "tools-update"
      },
      {
        "type": "repo_releases",
        "owner": "vic",
        "repo": "den",
        "enabled": true,
        "profile": "tools-update"
      }
    ],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "CNBC Finance",
        "url": "https://search.cnbc.com/rs/search/combinedcms/view.xml?partnerId=wrss01&id=10000664",
        "enabled": true,
        "category": "finance",
        "profile": "finance-news",
        "content_extractor": "trafilatura"
      },
      {
        "name": "GitHub Trending - Daily",
        "url": "https://mshibanami.github.io/GitHubTrendingRSS/daily/all.xml",
        "enabled": true,
        "category": "github-trending",
        "profile": "tech-news"
      },
      {
        "name": "Semianalysis",
        "url": "https://newsletter.semianalysis.com/feed",
        "enabled": true,
        "category": "semiconductors",
        "profile": "tech-news"
      },
      {
        "name": "LWN.net",
        "url": "https://lwn.net/headlines/full_text?key=${LWN_KEY}",
        "enabled": true,
        "category": "linux-kernel",
        "profile": "tech-news"
      }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        },
        {
          "subreddit": "singularity",
          "enabled": true,
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 60,
          "profile": "tech-news"
        }
      ],
      "users": [],
      "fetch_comments": 10
    },
    "telegram": {
      "enabled": true,
      "channels": [
        {
          "channel": "zaihuapd",
          "enabled": true,
          "fetch_limit": 20,
          "profile": ["tech-news", "finance-news"]
        }
      ]
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": null,
    "profile_order": [
      "tools-update",
      "tech-news",
      "tech-blog",
      "finance-news"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": true,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary_and_items",
    "overview_position": "last",
    "platform": "discord",
    "layout": "markdown",
    "fallback_layout": "markdown",
    "languages": ["en"],
    "request_body": {
      "content": "**#{message_title}**\n\n#{summary?limit=1800&split=---}"
    },
    "headers": ""
  }
}
