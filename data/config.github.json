{
  "ai": {
    "provider": "anthropic",
     "model": "claude-haiku-5-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 1,
    "languages": ["fr"],
    "analysis_concurrency": 3,
    "enrichment_concurrency": 3
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "startup-news",
    "profile_settings": {
      "startup-news": { "threshold": 6.5, "topic_dedup": true },
      "tech-news": { "threshold": 7.5, "topic_dedup": true },
      "tech-blog": { "threshold": 6.0, "topic_dedup": false }
    }
  },
  "sources": {
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 30,
      "min_score": 150,
      "profile": ["tech-news", "startup-news"]
    },
    "rss": [
      { "name": "Maddyness", "url": "https://www.maddyness.com/feed/", "enabled": true, "category": "startups-fr", "profile": "startup-news" },
      { "name": "FrenchWeb", "url": "https://www.frenchweb.fr/feed", "enabled": true, "category": "startups-fr", "profile": "startup-news" },
      { "name": "L'Usine Digitale", "url": "https://www.usine-digitale.fr/rss", "enabled": true, "category": "tech-fr", "profile": ["tech-news", "startup-news"] },
      { "name": "Sifted", "url": "https://sifted.eu/feed", "enabled": true, "category": "startups-eu", "profile": "startup-news" },
      { "name": "EU-Startups", "url": "https://www.eu-startups.com/feed/", "enabled": true, "category": "startups-eu", "profile": "startup-news" },
      { "name": "TechCrunch Startups", "url": "https://techcrunch.com/category/startups/feed/", "enabled": true, "category": "startups-us", "profile": "startup-news" },
      { "name": "TechCrunch Venture", "url": "https://techcrunch.com/category/venture/feed/", "enabled": true, "category": "venture", "profile": "startup-news" },
      { "name": "Product Hunt", "url": "https://www.producthunt.com/feed", "enabled": true, "category": "nouveaux-produits", "profile": "startup-news" },
      { "name": "Lenny's Newsletter", "url": "https://www.lennysnewsletter.com/feed", "enabled": true, "category": "produit-growth", "profile": "tech-blog", "content_extractor": "trafilatura" },
      { "name": "Stratechery", "url": "https://stratechery.com/feed/", "enabled": true, "category": "strategie", "profile": "tech-blog" },
      { "name": "Simon Willison", "url": "https://simonwillison.net/atom/everything/", "enabled": true, "category": "ia", "profile": "tech-news" }
    ],
    "reddit": {
      "enabled": true,
      "subreddits": [
        { "subreddit": "startups", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 15, "min_score": 40, "profile": "startup-news" },
        { "subreddit": "SaaS", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 30, "profile": "startup-news" },
        { "subreddit": "Entrepreneur", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 80, "profile": "startup-news" },
        { "subreddit": "artificial", "enabled": true, "sort": "hot", "time_filter": "day", "fetch_limit": 10, "min_score": 80, "profile": "tech-news" }
      ],
      "users": [],
      "fetch_comments": 5
    },
    "google_news": {
      "enabled": true,
      "query": "startup levée de fonds",
      "language": "fr",
      "country": "FR",
      "ceid": null,
      "max_results": 40,
      "category": "levees-fr",
      "profile": "startup-news"
    },
    "ossinsight": {
      "enabled": true,
      "period": "past_24_hours",
      "languages": ["All"],
      "keywords": ["agent", "llm", "ai"],
      "min_stars": 50,
      "max_items": 10,
      "profile": "tech-news"
    }
  },
  "collection": { "time_window_hours": 24 },
  "digest": {
    "max_items": 25,
    "profile_order": ["startup-news", "tech-news", "tech-blog"],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  }
}
